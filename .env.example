# ============================================================
# CampusBite Canteen Management System - Environment Variables
# Copy this file to .env for local testing if needed
# ============================================================

# Application Environment: 'development' or 'production'
APP_ENV=development

# Database Connection (Standard or AWS RDS)
# For local XAMPP MySQL:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=canteen_db
DB_USER=root
DB_PASSWORD=

# For AWS Elastic Beanstalk + AWS RDS (automatically populated by Beanstalk if linked):
# RDS_HOSTNAME=canteen-rds.c12345678.us-east-1.rds.amazonaws.com
# RDS_PORT=3306
# RDS_DB_NAME=canteen_db
# RDS_USERNAME=admin
# RDS_PASSWORD=YourSecureRDSPassword123!
